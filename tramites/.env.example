# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# Database
#--------------------------------------------------------------------
DB_CONNECTION=pg
DB_HOST=localhost
DB_PORT=5432
DB_USER=municipalidad
DB_PASSWORD=municipalidad_dev
DB_DATABASE=municipalidad

#--------------------------------------------------------------------
# Services
#--------------------------------------------------------------------
# Base URL of the usuarios service. Inside Docker it is the gateway, so that
# every request between services goes through nginx: http://gateway
USUARIOS_SERVICE_URL=http://gateway

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000